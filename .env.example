# ============================================================
# 실전 투자 운영 앱 환경변수
# .env.example 복사 후 .env로 저장, 실제 값 입력
# ============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://trader:password@localhost:5432/trading_db
DATABASE_URL_SYNC=postgresql://trader:password@localhost:5432/trading_db

# ── Redis ─────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── App ───────────────────────────────────────────────────
APP_ENV=development         # development | production
SECRET_KEY=change-this-to-a-long-random-string-in-production
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Kiwoom REST API (실전 계좌 전용) ──────────────────────
# 발급처: openapi.kiwoom.com > 앱 등록
KIWOOM_APP_KEY=your_app_key_here
KIWOOM_APP_SECRET=your_app_secret_here
KIWOOM_ACCOUNT_NUMBER=your_account_number_here  # 예: 1234567890

# Kiwoom API 환경 (real | mock)
# ⚠ 본 앱은 real 전용. mock은 내부 개발 검증 목적으로만 사용
KIWOOM_ENV=real

# Kiwoom 기본 URL (확인 필요: openapi.kiwoom.com 문서 참조)
KIWOOM_BASE_URL=https://api.kiwoom.com
KIWOOM_WS_URL=wss://api.kiwoom.com:10000

# ── 주문 안전장치 ──────────────────────────────────────────
# 실주문 활성화 kill switch (false = 주문초안 생성만, 실전송 없음)
ORDER_EXECUTION_ENABLED=false

# 1회 최대 주문 금액 (원) - 안전장치
ORDER_MAX_AMOUNT_KRW=5000000

# ── 스케줄러 ──────────────────────────────────────────────
# 테마 점수 갱신 주기 (분)
THEME_SCORE_INTERVAL_MINUTES=30

# 포트폴리오 동기화 주기 (분)
PORTFOLIO_SYNC_INTERVAL_MINUTES=5
